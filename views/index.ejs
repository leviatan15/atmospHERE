 ///function for automatic next/prev day request       
function strictRequest(prevornext) {
const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/getweather';

  let prevnext = ""
  prevornext == "prev" ? prevnext = "prev" : prevnext = "next"

let nextNeeded = ""
  if (prevornext == "prev"){
    const date = new Date(dateNextDay)
    let unixNow = date.setDate(date.getDate() - 1)
    nextNeeded = date.toISOString().split('T')[0]
  }

   else if (prevornext == "next"){
   const date = new Date(dateNextDay)
    let unixNow = date.setDate(date.getDate() + 1)
    nextNeeded = date.toISOString().split('T')[0]
  }
  
  const data = {
    citynext: cityNextDay,
    countrynext: countryNextDay,
    datenext: nextNeeded,
    mode: 'strict',
    dir: prevnext
  }

  for (const key in data) {
    const input = document.createElement('input')
    input.type = 'hidden'
    input.name = key
    input.value = data[key]
    form.appendChild(input)
  }

  document.body.appendChild(form);
  form.submit();
  document.querySelector("#loading-screen").style.display = "flex"
          }
